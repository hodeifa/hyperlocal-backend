meta {
  name: Register Customer - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/customer/register
  body: json
  auth: none
}

body:json {
  {
    "phone_number": "+628123456789"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Response contains has_driver_role", function() {
    expect(res.body.data.has_driver_role).to.be.a("boolean");
  });
}